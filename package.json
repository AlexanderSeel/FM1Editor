{
  "name": "fm1-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-patch-catalog.mjs --best-effort",
    "dev": "vite",
    "catalog:sync": "node scripts/sync-patch-catalog.mjs",
    "catalog:audit": "node scripts/catalog-release-audit.mjs",
    "catalog:audit:check": "node scripts/catalog-release-audit.mjs --check",
    "audit:virtual-dx7": "node scripts/verify-msfa-source-audit.mjs",
    "audit:virtual-dx7:upstream": "node scripts/audit-msfa-upstream.mjs",
    "prebuild": "node scripts/sync-patch-catalog.mjs --best-effort",
    "build": "tsc -b && vite build && node scripts/inject-service-worker-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "release:verify": "npm run catalog:sync && npm run catalog:audit:check && npm run audit:virtual-dx7 && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
