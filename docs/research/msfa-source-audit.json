    "requiredBeforeVendoring": [
      "materialize the pinned upstream files from the exact commit",
      "compute and record SHA-256 for every copied or modified upstream file",
      "retain original copyright and Apache-2.0 headers on derived files",
      "add Apache-2.0 license text and a project NOTICE/attribution file",
      "run scripts/verify-msfa-source-audit.mjs against the materialized source set"
    ]
  },
  "boundaryDecisions": {
    "standardTuning": "Do not copy Source/msfa/tuning.h or tuning.cc. Implement a small FM1 Editor-owned 12-TET adapter matching the standard-tuning arithmetic used by the pinned source. Microtuning is outside the feasibility spike.",
    "mtsEsp": "Do not compile or copy MTS-ESP in the feasibility spike. Remove MTS-ESP references from the derived note wrapper. Audit an exact MTS-ESP revision only if microtuning is added later.",
    "controllers": "controllers.h is Apache-2.0-marked but includes GPL-3.0 Source/Dexed.h. A derived spike copy must remove that include and remain limited to controller state required by the renderer.",
    "envelope": "env.cc is Apache-2.0-marked but includes GPL-3.0 Source/Dexed.h. The include is outside the synthesis algorithm and must be removed in the derived spike copy.",
    "note": "dx7note.h/.cc are Apache-2.0-marked but currently depend on tuning and MTS-ESP integration. The derived spike must keep standard 12-TET behavior while removing those optional dependencies.",
    "effects": "No Dexed effects, JUCE audio graph, UI, cartridge, SysEx wrapper or plugin code is part of the dry renderer. FM-1-inspired effects remain a separate later Web Audio layer."
  },
